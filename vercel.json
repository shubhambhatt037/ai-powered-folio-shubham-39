{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.shubhambhatt.me" }],
      "destination": "https://shubhambhatt.me/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shubhambhatt.vercel.app" }],
      "destination": "https://shubhambhatt.me/:path*",
      "permanent": true
    },
    {
      "source": "/assets/avatar.jpg",
      "destination": "/assets/shubham-bhatt.jpg",
      "permanent": true
    }
  ]
}
